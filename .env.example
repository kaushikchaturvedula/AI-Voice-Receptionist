# Copy this file to `.env` and fill in your values. `.env` is loaded automatically
# at startup by python-dotenv, so you don't need to `export` anything.

# Required: your OpenAI API key.
OPENAI_API_KEY=sk-...

# Optional: which OpenAI chat model to use. Defaults to gpt-5.4-mini if unset.
# Any chat-capable model that supports tool calling works here.
OPENAI_MODEL=gpt-5.4-mini

# Optional: path to the Piper voice model. Defaults to en_US-lessac-medium.onnx
# in the working directory.
# PIPER_MODEL=en_US-lessac-medium.onnx

# Optional: speech-recognition model. tiny.en < base.en < small.en (slower but more
# accurate). Defaults to base.en. On a slow CPU, try small.en only if you can wait longer.
# ASR_MODEL=base.en

# Optional: milliseconds of trailing silence before the receptionist decides you've
# finished talking. Defaults to 900. Lower = snappier but cuts you off on pauses;
# higher = more patient but adds a beat of latency.
# SILENCE_MS=900

# Optional: barge-in (talking over the receptionist) sensitivity. While it's speaking,
# sustained input energy above max(BARGE_RMS_MIN, noise_floor * BARGE_FACTOR) for
# BARGE_CHUNKS frames interrupts it. If it ignores you, lower BARGE_RMS_MIN/BARGE_FACTOR;
# if it interrupts itself (you're on speakers, not headphones), raise them.
# BARGE_RMS_MIN=0.015
# BARGE_FACTOR=3.0
# BARGE_CHUNKS=4

# Optional: at startup, play a short probe tone and measure how much of it leaks back
# into the mic, learning the speaker->mic echo coupling. Set to 0 to skip the test tone
# (disables the echo-cancelling gate below; barge-in then uses only the static floor).
# CALIBRATE=1

# Optional: echo-cancellation margin. While speaking, the app predicts its own echo at
# the mic and only treats input as a real interruption when it's this many times louder
# than the prediction. Higher = more robust against self-triggering on loud speakers but
# needs you to speak up to interrupt; lower = easier to interrupt but riskier on speakers.
# AEC_MARGIN=2.5
